# ============================================================
# Secrets - NEVER commit real credentials
# ============================================================
.env
.env.*
!.env.example

# ============================================================
# Runtime data / persistent volumes
# Docker named volumes do NOT live here, but bind-mount dirs do
# ============================================================
volumes/*
!volumes/.gitkeep
data/
*.log

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# 锚定到仓库根：Python 构建产物只会出现在根目录。
# 不能写成 `lib/` —— 那会连 infrastructure/flink/lib/ 一起忽略掉，
# 导致 Flink 连接器下载脚本无法进入版本库。
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 第三方二进制（JAR 由脚本从 Maven Central 获取，不入 Git）
*.jar

# 前端运行时（Vue / ECharts 由 scripts/install-web.sh 从 npmmirror 获取，
# 属第三方构建产物，约 1.1 MB，不入 Git）
services/web/vendor/

# Virtual environments
.venv/
venv/
ENV/
env/
.python-version
# Sprint 4：Airflow 的独立 venv（与 .venv / .venv-agent 同样的理由）
# 注意 .venv-airflow 不以 `.venv/` 结尾，上面那条匹配不到，必须单列。
.venv-airflow/

# ============================================================
# Sprint 4 — Airflow
#
# AIRFLOW_HOME 放在仓库内（/opt/data-platform/airflow），
# 这样 DAG 代码可以进版本库；但同一个目录下还有**机器状态**，
# 那些绝不能进 Git：
#   logs/                     运行日志（含任务输出）
#   airflow.env               含元数据库口令（0640 dpaiflow:dpapi）
#   simple_auth_passwords.json 登录口令（明文 JSON）
#   airflow.cfg / webserver_config.py  Airflow 自己生成的配置
#   *.db                      万一退回 sqlite 时的元数据库文件
# ============================================================
airflow/logs/
airflow/plugins/
airflow/airflow.env
airflow/airflow.cfg
airflow/webserver_config.py
airflow/simple_auth_passwords.json
airflow/*.db
airflow/*.sqlite
airflow/*.pid
airflow/*.lock

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Type checkers / linters / formatters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.cache/

# ============================================================
# IDE / Editor
# ============================================================
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================================
# Local overrides
# ============================================================
docker-compose.override.yml
*.local.yml
*.local

# ============================================================
# Generated data samples (regenerate with data-generator)
# ============================================================
data-generator/output/
*.csv
*.parquet
!tests/**/*.csv
