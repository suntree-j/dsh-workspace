# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/
.python-version

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Type checkers / linters / formatters
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.cache/

# ============================================================
# IDE / Editor
# ============================================================
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db

