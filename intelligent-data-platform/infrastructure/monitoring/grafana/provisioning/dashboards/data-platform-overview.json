      "datasource": { "type": "mysql", "uid": "doris-mysql" },
      "gridPos": { "h": 5, "w": 8, "x": 8, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT MAX(window_start) AS `最新流量窗口` FROM lakehouse_ads.ads_traffic_1m"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "dateTimeAsIso", "decimals": 0 }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "流量域最新天分区（ads_traffic_1d.dt）",
      "datasource": { "type": "mysql", "uid": "doris-mysql" },
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT MAX(dt) AS `最新天分区` FROM lakehouse_ads.ads_traffic_1d"
        }
