    {
      "id": 11,
      "type": "timeseries",
      "title": "每日 PV / UV（离线 ads_traffic_1d）",
      "description": "UV 是去重用户数，跨天不可加；PV 可加。两者画在一起时看的是趋势而不是量级",
      "datasource": { "type": "mysql", "uid": "doris-mysql" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT dt AS time, SUM(pv) AS `PV`, SUM(uv) AS `UV` FROM lakehouse_ads.ads_traffic_1d WHERE UNIX_TIMESTAMP(dt) >= UNIX_TIMESTAMP(NOW()) - $__range_s GROUP BY dt ORDER BY dt"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8, "showPoints": "auto", "spanNulls": true }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "barchart",
      "title": "行为漏斗（离线 ads_traffic_1d 全历史合计，应当逐级收窄）",
      "description": "AGENTS.md 8.2 的数据正确性断言：VIEW > CLICK > CART > BUY。若某级反超，先看 DWD 去重是否生效。这里刻意**不做时间过滤**：全历史合计是固定的口径基线，便于任何时间点复核",
      "datasource": { "type": "mysql", "uid": "doris-mysql" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT 'VIEW' AS `行为`, SUM(view_cnt) AS `次数` FROM lakehouse_ads.ads_traffic_1d UNION ALL SELECT 'CLICK', SUM(click_cnt) FROM lakehouse_ads.ads_traffic_1d UNION ALL SELECT 'CART', SUM(cart_cnt) FROM lakehouse_ads.ads_traffic_1d UNION ALL SELECT 'FAVORITE', SUM(favorite_cnt) FROM lakehouse_ads.ads_traffic_1d UNION ALL SELECT 'BUY', SUM(buy_cnt) FROM lakehouse_ads.ads_traffic_1d"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "xTickLabelRotation": 0,
        "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },

