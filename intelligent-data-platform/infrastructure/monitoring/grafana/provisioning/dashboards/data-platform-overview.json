    {
      "id": 6,
      "type": "row",
      "title": "二、交易域（离线 ADS：GMV / 订单量 / 支付成功率）",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "每日 GMV（离线 ads_batch_trade_1d，单位：元）",
      "datasource": { "type": "mysql", "uid": "doris-mysql" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT dt AS time, SUM(gmv) AS `每日GMV` FROM lakehouse_ads.ads_batch_trade_1d WHERE UNIX_TIMESTAMP(dt) >= UNIX_TIMESTAMP(NOW()) - $__range_s GROUP BY dt ORDER BY dt"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyCNY",
          "decimals": 2,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto", "spanNulls": true }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "每日订单量（离线 ads_batch_trade_1d）",
      "datasource": { "type": "mysql", "uid": "doris-mysql" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT dt AS time, SUM(order_cnt) AS `每日订单量` FROM lakehouse_ads.ads_batch_trade_1d WHERE UNIX_TIMESTAMP(dt) >= UNIX_TIMESTAMP(NOW()) - $__range_s GROUP BY dt ORDER BY dt"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 60, "showPoints": "never", "spanNulls": true }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "交易指标快照（离线 ads_batch_trade_1d 最近 10 天）",
      "description": "avg_order_amount / payment_success_rate / refund_rate 分母为 0 时为 NULL —— 那是口径约定，不是数据缺失（见 sql/metadata/metrics.md）",
      "datasource": { "type": "mysql", "uid": "doris-mysql" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT dt AS `日期`, gmv AS `GMV`, order_cnt AS `订单量`, order_user_cnt AS `下单用户`, avg_order_amount AS `客单价`, payment_cnt AS `支付成功`, payment_fail_cnt AS `支付失败`, payment_success_rate AS `支付成功率`, refund_cnt AS `退款笔数`, refund_amount AS `退款金额`, refund_rate AS `退款率` FROM lakehouse_ads.ads_batch_trade_1d WHERE UNIX_TIMESTAMP(dt) >= UNIX_TIMESTAMP(NOW()) - $__range_s ORDER BY dt DESC LIMIT 10"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false, "reducer": ["sum"], "countRows": false, "fields": "" }
      },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "filterable": false } }, "overrides": [] }
    },

    {
      "id": 10,
      "type": "row",
      "title": "三、流量域（离线 ADS：UV / PV / 行为漏斗）",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "collapsed": false,
      "panels": []
