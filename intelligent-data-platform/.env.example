# ============================================================
# 基于 Lakehouse 与 AI Agent 的批流一体智能数据分析平台
# Sprint 0 - Environment Template
# ============================================================
#
# 使用方法：
#   cp .env.example .env
# 然后修改 .env 中的口令。
#
# !! 重要 !!
#   - .env 已被 .gitignore 忽略，禁止提交。
#   - 本文件中只能出现占位符，禁止写入真实口令 / API Key / LLM Token。
#   - 所有服务通过 Docker 网络 data-platform 以服务名互访，
#     容器内部禁止使用 localhost / 127.0.0.1。
# ============================================================

# ------------------------------------------------------------
# Timezone
# ------------------------------------------------------------
TZ=Asia/Shanghai

# ------------------------------------------------------------
# Docker 网络 data-platform
#
# 为什么需要固定子网与固定 IP？
#   Doris 的 init_fe.sh / entry_point.sh 使用正则严格校验
#   FE_SERVERS=<name>:<IPv4>:<port>，**不接受主机名**。
#   同时脚本会把 priority_networks 推导为 <IP 前三段>.0/24。
#   因此 Doris FE/BE 必须使用固定 IP，且网段必须与子网一致。
#   详见 docs/development-environment.md 第 4.5 / 4.6 节。
#
# 若该网段与目标机器上已有网络冲突，只需修改下面三个变量。
# ------------------------------------------------------------
DATA_PLATFORM_SUBNET=172.28.0.0/24
DORIS_FE_IP=172.28.0.10
DORIS_BE_IP=172.28.0.11

# ------------------------------------------------------------
# MySQL  (service name: mysql, in-network port: 3306)
# ------------------------------------------------------------
MYSQL_VERSION=8.4.11
MYSQL_HOST_PORT=3306
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=ecommerce
MYSQL_USER=app
MYSQL_PASSWORD=change_me_app

# ------------------------------------------------------------
# Kafka  (service name: kafka, in-network port: 9092)
# 使用 Apache Kafka 官方镜像的 KRaft 模式，单节点，无需 ZooKeeper。
#
# 监听器说明（双监听器，见 README「Kafka 连接方式」）：
#   kafka:9092        容器之间使用（符合项目网络规范）
#   localhost:19092   宿主机上的 Python / CLI 客户端使用
#
# 为什么要分两个端口？
#   Kafka 的 advertised.listeners 必须是客户端能直接连通的地址。
#   容器与宿主机能解析的地址不同，因此需要两个监听器。
# ------------------------------------------------------------
KAFKA_VERSION=4.2.1
KAFKA_BROKER_ID=1
KAFKA_PORT=9092
KAFKA_EXTERNAL_PORT=19092

KAFKA_TOPIC_PARTITIONS=3
KAFKA_TOPIC_REPLICATION_FACTOR=1

# ------------------------------------------------------------
# MinIO  (service name: minio, in-network API 9000 / Console 9001)
# 注意：MinIO 自 2025-10 起停止免费分发官方 Docker 镜像，
#       本项目使用社区再托管的最后一个官方发行版，详见
#       docs/development-environment.md
# ------------------------------------------------------------
MINIO_IMAGE=coollabsio/minio
MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_BUCKET=lakehouse

# ------------------------------------------------------------
# Apache Doris  (service name: doris-fe / doris-be)
#   MySQL protocol port : 9030   (doris-fe:9030)
#   FE HTTP port        : 8030
#   FE edit_log port    : 9010   (集群内部通信，不映射到宿主)
#   BE HTTP/心跳端口     : 8040 / 9050 / 9060
# FE/BE 镜像使用同一版本，必须一致。
#
# FE_SERVERS / BE_ADDR 由 docker-compose.yml 依据
# DORIS_FE_IP / DORIS_BE_IP 自动组装，无需在此重复配置。
# ------------------------------------------------------------
DORIS_VERSION=4.1.4
DORIS_FE_HTTP_PORT=8030
DORIS_FE_QUERY_PORT=9030
DORIS_BE_HTTP_PORT=8040
DORIS_ROOT_PASSWORD=change_me_doris

# FE JVM 堆大小。Doris FE 默认堆较大，单机开发环境需要限制。
DORIS_FE_JAVA_OPTS=-Xmx1536m -Xms768m -XX:MaxMetaspaceSize=384m

# BE 内存上限（字节）。BE 默认使用物理内存的 80%，
# 本机 15.7GB，若不限制会严重影响宿主机。默认 4GiB。
DORIS_BE_MEM_LIMIT=4294967296

# ------------------------------------------------------------
# Sprint 1 — Apache Flink（实时数仓）
#
# 架构：Kafka 事件 → Flink 清洗/聚合 → Kafka 指标 topic
#       → Doris Routine Load → DWD / DWS / ADS 表
# 详见 docs/sprint/SPRINT_1.md
# ------------------------------------------------------------
FLINK_VERSION=1.20.1-scala_2.12-java17
# REST API（Web UI）与 SQL Gateway 端口
FLINK_REST_PORT=8081
FLINK_SQL_GATEWAY_PORT=8083
# TaskManager 进程内存。服务器 16 GB 需与 Doris/Kafka/MySQL/MinIO 共存，
# 故默认 3 GB（JobManager 1 GB，Flink 合计约 4 GB）。
FLINK_TASKMANAGER_MEMORY=3072m
# TaskManager slot 数。Sprint 1 共 8 个常驻作业（4 DWD + 4 指标），
# 每作业占 1 slot，故默认 8。
FLINK_TASKMANAGER_SLOTS=8
# 作业提交容器使用的基础镜像（需 python3 做 JSON 转义）
PYTHON_VERSION=3.12

# ------------------------------------------------------------
# Sprint 6 — 数据服务（只读指标 API）
#
# 服务层直接部署在宿主机（systemd + Nginx），**不进 Docker**：
#   浏览器 → Nginx(:80) → /data/ 静态前端
#                       → /data/api/ 反向代理 → uvicorn(127.0.0.1:8000)
#
# 安全约束（AGENTS.md 第 10 节）：
#   接口只读，使用**专用只读账号**连 Doris，不使用 root；
#   口令只从本文件注入，代码里没有任何默认口令。
#   首次部署用 bash scripts/install-web.sh 生成并写入下方口令。
# ------------------------------------------------------------
API_TITLE=批流一体智能数据分析平台 · 数据服务
API_VERSION=1.0.0
# 只监听回环地址：对外只经 Nginx 暴露，避免绕过反向代理直连
API_HOST=127.0.0.1
API_PORT=8000
# 对外路径前缀（Nginx 的 location 与此保持一致）
API_ROOT_PATH=/data/api
# 只读账号（由 install-web.sh 在 Doris 中创建：GRANT SELECT_PRIV）
API_DORIS_USER=agent_ro
API_DORIS_PASSWORD=change_me_api_doris
API_DORIS_DATABASE=ecommerce
# 查询保护：连接超时 / 查询超时 / 默认与最大返回行数
API_CONNECT_TIMEOUT=5
API_QUERY_TIMEOUT=15
API_DEFAULT_LIMIT=60
API_MAX_LIMIT=1000

# ------------------------------------------------------------
# Data Generator
#
# 仓库中的 .env 是给 **宿主机** 上的 Python 使用的，
# 因此这里使用 localhost + 宿主机映射端口。
#
# 容器内运行时不需要这些值：docker-compose.yml 已为
# data-generator 服务显式注入服务名（mysql / kafka / minio），
# 容器内禁止使用 localhost。
# ------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
MINIO_ENDPOINT=http://localhost:9000

# 数据生成规模（Sprint 0 要求：用户 1000+、商品 500+、订单 5000+、支付 5000+）
GEN_USER_COUNT=1200
GEN_PRODUCT_COUNT=600
GEN_ORDER_COUNT=6000
GEN_BEHAVIOR_EVENT_COUNT=20000
GEN_REFUND_RATIO=0.05

# 固定随机种子，保证数据可复现
GEN_RANDOM_SEED=20260926
