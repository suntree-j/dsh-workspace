# ============================================================
# dsh-workspace 工作区根 .gitattributes
# ============================================================
#
# 作用：统一行尾，避免在 Windows 上开发、在 Linux 服务器上运行时
#       出现 `bash\r: No such file or directory` 之类的错误。
#
# 注意：intelligent-data-platform/ 下另有自己的 .gitattributes，
#       子目录规则优先于本文件。
# ============================================================

* text=auto eol=lf

# ------------------------------------------------------------
# Shell / 配置：必须 LF
# ------------------------------------------------------------
*.sh        text eol=lf
*.bash      text eol=lf
*.sql       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.json      text eol=lf

# ------------------------------------------------------------
# Windows 专用脚本：必须 CRLF
# ------------------------------------------------------------
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# ------------------------------------------------------------
# 二进制：禁止转换
# ------------------------------------------------------------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tar   binary
*.jar   binary
*.parquet binary
*.woff  binary
*.woff2 binary

# ------------------------------------------------------------
# 语言统计
# ------------------------------------------------------------
*.lock  linguist-generated=true
